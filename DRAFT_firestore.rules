rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny all unexpected collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'updatedAt'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidBuildingData(data, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'settings', 'apartments', 'cycles', 'activeCycleId', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'settings', 'apartments', 'cycles', 'activeCycleId', 'version', 'updatedAt'])
        && data.id is string && data.id == userId
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.settings is map
        && data.apartments is list && data.apartments.size() <= 200
        && data.cycles is list && data.cycles.size() <= 120
        && data.activeCycleId is string && data.activeCycleId.size() <= 50
        && (!('version' in data) || data.version is number)
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /buildings/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidBuildingData(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidBuildingData(request.resource.data, userId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
